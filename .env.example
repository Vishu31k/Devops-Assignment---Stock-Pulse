# ==============================================================================
# Environment Variables — Root Configuration Example
# ==============================================================================
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to Git. It contains secrets!
# This .env.example file is safe to commit because it only has placeholders.
# ==============================================================================

# JWT Secret — used to sign authentication tokens
# Change this to any random string in production
JWT_SECRET=stockpulse_jwt_secret_change_me

# Alpha Vantage API Key — provides real stock market data
# Get a free key at: https://www.alphavantage.co/support/#api-key
# If left as 'demo', the app will use mock/sample data instead
ALPHA_VANTAGE_API_KEY=demo
