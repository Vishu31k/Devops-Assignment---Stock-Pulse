# ==============================================================================
# Stock Pulse — .gitignore
# ==============================================================================
# This file tells Git which files and folders to IGNORE (not track).
# These are files that should NOT be uploaded to GitHub because they are:
#   - Generated automatically (node_modules, dist, build)
#   - Contain secrets (.env files)
#   - IDE/editor specific (.vscode, .idea)
#   - Operating system files (.DS_Store, Thumbs.db)
# ==============================================================================

# ---------- Node.js ----------
# The node_modules folder contains all downloaded npm packages.
# It is very large and should NEVER be committed to Git.
# Anyone can recreate it by running "npm install".
node_modules/

# ---------- Build Output ----------
# These folders contain compiled/built files generated by Vite or React.
# They are recreated every time you run "npm run build".
dist/
build/

# ---------- Environment Variables ----------
# .env files contain sensitive configuration like database passwords,
# API keys, and JWT secrets. NEVER commit these to GitHub.
# Instead, use .env.example as a template (which IS committed).
.env
.env.local
.env.production

# ---------- Test Coverage ----------
# Generated by test runners to show code coverage reports.
coverage/

# ---------- IDE / Editor ----------
# Configuration files specific to your code editor.
# Other developers may use different editors.
.vscode/
.idea/
*.swp
*.swo

# ---------- Operating System ----------
# System files created by macOS and Windows.
.DS_Store
Thumbs.db

# ---------- Logs ----------
# Log files generated during development or by npm.
*.log
npm-debug.log*

# ---------- Docker ----------
# Docker Compose override file (used for local customization).
docker-compose.override.yml
